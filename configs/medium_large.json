{
  "seq_length": 4096,
  "model": {
    "d_model": 2048,
    "n_layers": 16,
    "n_heads": 16,
    "hidden_size_multiplier": 1.5,
    "block_name": "reordered_norm",
    "qk_norm": true,
    "rope_theta": 500000,
    "layer_norm_eps": 1e-06,
    "n_kv_heads": 16,
    "tie_word_embeddings": true,
    "init_std": 0.02
  },
  "training": {
    "epochs": 1,
    "micro_batch_size": 8,
    "learning_rate": 0.0001,
    "weight_decay": 0.1,
    "decay_fraction": 0.1,
    "decay_min_lr": 0.0,
    "compile": true,
    "logging_steps": 10,
    "eval_steps": 50000,
    "save_steps": 10000,
    "num_workers": 2,
    "report_to": "none",
    "seed": 42,
    "gradient_accumulation_steps": 4,
    "warmup_steps": 96
  }
}
